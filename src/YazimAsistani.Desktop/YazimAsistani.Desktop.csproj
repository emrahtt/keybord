<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>YazimAsistani.Desktop</RootNamespace>
    <AssemblyName>YazimAsistani</AssemblyName>
    <Product>Yazım Asistanı</Product>
    <Description>Türkçe ve İngilizce için çevrimdışı öncelikli Windows yazım yardımcısı.</Description>
    <Version>1.0.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../YazimAsistani.Core/YazimAsistani.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="System.Speech" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../../README.md" Link="README.md" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../docs/PRIVACY.md" Link="docs/PRIVACY.md" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../docs/THIRD_PARTY_NOTICES.md" Link="docs/THIRD_PARTY_NOTICES.md" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../docs/USER_GUIDE.md" Link="docs/USER_GUIDE.md" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

