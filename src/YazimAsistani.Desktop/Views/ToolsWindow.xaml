<Window x:Class="YazimAsistani.Desktop.Views.ToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Araçlar / Tools"
        Width="820"
        Height="610"
        MinWidth="700"
        MinHeight="500"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <TabControl>
            <TabItem Header="Sözlük / Dictionary">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBox x:Name="WordSearchBox"
                             TextChanged="WordSearchChanged"
                             ToolTip="Kelime ara / Search words" />
                    <ListBox x:Name="WordList" Grid.Row="2" />
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="NewWordBox"
                                 Margin="0,0,8,0"
                                 ToolTip="Yeni kelime / New word" />
                        <TextBox x:Name="WordAliasesBox"
                                 Grid.Column="1"
                                 Margin="0,0,8,0"
                                 ToolTip="Virgülle ayrılmış alternatifler / Comma-separated aliases" />
                        <ComboBox x:Name="WordLanguageBox"
                                  Grid.Column="2"
                                  Width="100"
                                  Margin="0,0,8,0"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="Türkçe" Tag="Turkish" />
                            <ComboBoxItem Content="English" Tag="English" />
                        </ComboBox>
                        <Button Grid.Column="3" Content="Ekle / Add" Click="AddWordClicked" />
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Kısaltmalar / Snippets">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ListBox x:Name="SnippetList" DisplayMemberPath="Trigger" />
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SnippetTriggerBox"
                                 Margin="0,0,8,0"
                                 ToolTip="Kısaltma / Trigger" />
                        <TextBox x:Name="SnippetExpansionBox"
                                 Grid.Column="1"
                                 Margin="0,0,8,0"
                                 ToolTip="Tam metin / Expansion" />
                        <ComboBox x:Name="SnippetLanguageBox"
                                  Grid.Column="2"
                                  Margin="0,0,8,0"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="Türkçe" Tag="Turkish" />
                            <ComboBoxItem Content="English" Tag="English" />
                        </ComboBox>
                        <Button Grid.Column="3" Content="Kaydet / Save" Click="SaveSnippetClicked" />
                        <Button Grid.Column="4" Content="Sil / Delete" Click="DeleteSnippetClicked" />
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Klavye düzenleri / Layouts">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ListBox x:Name="LayoutList"
                             DisplayMemberPath="Name"
                             SelectionChanged="LayoutSelectionChanged" />
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="LayoutNameBox"
                                 Margin="0,0,8,0"
                                 ToolTip="Düzen adı / Layout name" />
                        <ComboBox x:Name="LayoutLanguageBox"
                                  Grid.Column="1"
                                  Margin="0,0,8,0"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="Her iki dil / Both" Tag="Both" />
                            <ComboBoxItem Content="Türkçe" Tag="Turkish" />
                            <ComboBoxItem Content="English" Tag="English" />
                        </ComboBox>
                        <Button Grid.Column="2" Content="Kaydet / Save" Click="SaveLayoutClicked" />
                        <Button Grid.Column="3" Content="Sil / Delete" Click="DeleteLayoutClicked" />
                    </Grid>
                    <TextBox x:Name="LayoutKeysBox"
                             Grid.Row="4"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="90"
                             ToolTip="Tuşları boşluk, virgül veya yeni satırla ayırın / Separate keys with spaces, commas, or new lines" />
                </Grid>
            </TabItem>

            <TabItem Header="Kurtarma / Recovery">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <CheckBox x:Name="HistoryEnabledCheckBox"
                              Content="Yazı kurtarmayı etkinleştir / Enable writing recovery"
                              Checked="HistoryEnabledChanged"
                              Unchecked="HistoryEnabledChanged" />
                    <TextBlock Grid.Row="2"
                               Text="Kurtarılabilir taslak / Recoverable draft"
                               FontWeight="SemiBold" />
                    <TextBox x:Name="RecoveryDraftBox"
                             Grid.Row="4"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" />
                    <Grid Grid.Row="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ListBox x:Name="RecentWordsList"
                                 Margin="0,0,8,0"
                                 MaxHeight="120" />
                        <ListBox x:Name="RecentSentencesList"
                                 Grid.Column="1"
                                 Margin="0,0,8,0"
                                 MaxHeight="120" />
                        <Button Grid.Column="2"
                                Content="Geçmişi sil / Clear"
                                Click="ClearHistoryClicked" />
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Yedek / Backup">
                <StackPanel Margin="18">
                    <TextBlock Text="Portable Data klasörünün tamamını tek ZIP dosyasında yedekleyin veya geri yükleyin."
                               TextWrapping="Wrap"
                               Foreground="{StaticResource MutedTextBrush}"
                               Margin="0,0,0,16" />
                    <WrapPanel>
                        <Button Content="Yedek oluştur / Create backup" Click="CreateBackupClicked" />
                        <Button Content="Yedeği geri yükle / Restore" Click="RestoreBackupClicked" />
                        <Button Content="Data klasörünü aç / Open folder" Click="OpenDataFolderClicked" />
                    </WrapPanel>
                    <TextBlock x:Name="BackupStatusText"
                               Margin="0,18,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </TabItem>

            <TabItem Header="AI (Gemini)">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="GeminiApiKeyBox"
                                     Margin="0,0,8,0"
                                     ToolTip="Gemini API anahtarı / API key" />
                        <TextBox x:Name="GeminiModelBox"
                                 Grid.Column="1"
                                 Margin="0,0,8,0"
                                 ToolTip="Model adı / Model name" />
                        <Button Grid.Column="2" Content="Anahtarı kaydet / Save key" Click="SaveGeminiKeyClicked" />
                        <Button Grid.Column="3" Content="Anahtarı sil / Delete" Click="DeleteGeminiKeyClicked" />
                    </Grid>
                    <TextBlock x:Name="GeminiCredentialStatus"
                               Grid.Row="2"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap" />
                    <WrapPanel Grid.Row="4">
                        <Button x:Name="CloudVoiceButton"
                                Content="Bulut ses kaydını başlat / Start cloud dictation"
                                Click="ToggleCloudVoiceClicked" />
                        <TextBlock Margin="10,6,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="Kayıt yalnızca durdurduğunuzda Gemini'ye gönderilir."
                                   TextWrapping="Wrap" />
                    </WrapPanel>
                    <TextBox x:Name="AiInputBox"
                             Grid.Row="6"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             ToolTip="Dönüştürülecek metin / Input text" />
                    <Grid Grid.Row="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="AiActionBox" SelectedIndex="0" Margin="0,0,8,0">
                            <ComboBoxItem Content="Yazımı düzelt / Correct" Tag="Correct" />
                            <ComboBoxItem Content="Sadeleştir / Simplify" Tag="Simplify" />
                            <ComboBoxItem Content="Resmîleştir / Formalize" Tag="Formalize" />
                            <ComboBoxItem Content="Özetle / Summarize" Tag="Summarize" />
                            <ComboBoxItem Content="Türkçeye çevir" Tag="TranslateToTurkish" />
                            <ComboBoxItem Content="Translate to English" Tag="TranslateToEnglish" />
                            <ComboBoxItem Content="Özel komut / Custom" Tag="Custom" />
                        </ComboBox>
                        <TextBox x:Name="AiCustomInstructionBox"
                                 Grid.Column="1"
                                 Margin="0,0,8,0"
                                 ToolTip="Özel komut / Custom instruction" />
                        <Button x:Name="RunAiButton"
                                Grid.Column="2"
                                Content="Çalıştır / Run"
                                Click="RunGeminiClicked" />
                        <Button Grid.Column="3"
                                Content="Sonucu kopyala / Copy"
                                Click="CopyAiResultClicked" />
                    </Grid>
                    <TextBox x:Name="AiOutputBox"
                             Grid.Row="10"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" />
                </Grid>
            </TabItem>

            <TabItem Header="Metin / Text tools">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBox x:Name="TextToolInput"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" />
                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <Button Content="Unicode + Onar / Repair" Click="NormalizeTextClicked" />
                        <Button Content="BÜYÜK / UPPER" Click="UpperTextClicked" />
                        <Button Content="küçük / lower" Click="LowerTextClicked" />
                    </StackPanel>
                    <TextBox x:Name="TextToolOutput"
                             Grid.Row="4"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" />
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>

